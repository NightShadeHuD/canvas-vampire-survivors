{
    "name": "canvas-vampire-survivors",
    "version": "2.8.0",
    "description": "Vanilla JavaScript HTML5 Canvas roguelite inspired by Vampire Survivors. Zero runtime dependencies.",
    "main": "server.js",
    "type": "commonjs",
    "private": false,
    "scripts": {
        "setup": "node scripts/setup.mjs",
        "start": "node server.js",
        "dev": "node server.js",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,json,yml,yaml,html,css,md}\"",
        "format:check": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,json,yml,yaml,html,css,md}\"",
        "test": "node --test test/*.test.js",
        "test:clock": "node scripts/check-clocks.mjs",
        "check:baseline": "node scripts/check-baseline.mjs",
        "check:suppressions": "node scripts/check-suppressions.mjs",
        "check:hygiene": "node scripts/check-hygiene.mjs",
        "check:coverage": "node scripts/check-coverage.mjs",
        "verify": "node scripts/verify.mjs",
        "check": "npm run verify",
        "a11y": "node scripts/a11y-audit.mjs",
        "smoke:boot": "node scripts/boot-smoke.mjs",
        "verify:browser": "npm run smoke:boot && npm run a11y",
        "verify:all": "npm run verify && npm run verify:browser",
        "smoke": "node scripts/runtime-smoke.js",
        "smoke:live": "node scripts/smoke-live-deploy.js",
        "smoke:extended": "node scripts/extended-smoke.js"
    },
    "keywords": [
        "game",
        "html5",
        "html5-canvas-game",
        "canvas",
        "roguelite",
        "vampire-survivors",
        "vampire-survivors-clone",
        "browser-roguelite",
        "bullet-hell",
        "browser-game",
        "vanilla-js",
        "zero-dependencies",
        "indie-game",
        "speedrun",
        "open-source"
    ],
    "author": "Survivor contributors",
    "license": "MIT",
    "engines": {
        "node": ">=22.18.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NightShadeHuD/canvas-vampire-survivors.git"
    },
    "bugs": {
        "url": "https://github.com/NightShadeHuD/canvas-vampire-survivors/issues"
    },
    "homepage": "https://github.com/NightShadeHuD/canvas-vampire-survivors#readme",
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "eslint": "^10.12.0",
        "playwright": "^1.63.0",
        "prettier": "^3.9.9"
    }
}
